# scripts/docs-budget.conf — 프로젝트별 값. check-docs-budget.sh 와 session-brief.sh 가 읽는다.
# 스킬의 새 가드로 스크립트를 갈아 끼워도 이 파일은 남는다 — 커스텀은 스크립트가 아니라 여기에 둔다.
# 필요한 줄만 주석을 풀어 쓴다. (bash 로 source 된다)

# ── 집행 모드 — 기존 프로젝트는 warn 으로 시작해 이전을 마치면 block 으로 올린다
# BUDGET_MODE=warn

# ── 집행 대상 가르기 — block 으로 올릴 때 반드시 보라.
#    「지난 결정은 고치지 않는다」는 규율이 있으면 과거는 압축할 수 없고, 그래서 hard 를 과거
#    최댓값에 맞추게 된다. 그러면 block 을 켜도 **새 결정은 아무것도 막히지 않는다**(장식이 된
#    가드다 — 통과하니까 아무도 눈치채지 못한다). 고침은 캡을 조이는 것이 아니라 집행 대상을
#    가르는 것이다: DECBODY_FROM 이상의 번호에만 hard 를 적용한다. 과거는 soft 로 계속 보인다.
#    회차·todo 엔 이 장치가 필요 없다 — **회전이 과거를 빼 가므로** 회전 뒤 현실에 hard 를
#    맞추면 그게 곧 새 항목 집행이다.
#    ⚠️ FROM 을 올려 「이번 것만」 빼지 말 것 — 그 한 번이 다음 기준이 된다.
# DECBODY_SOFT=20; DECBODY_HARD=40
# DECBODY_FROM=99

# ── 문서 형식 — 이 저장소의 형식에 맞춘다. 못 맞추면 가드가 "인식하지 못했다" 로 알린다
# ENTRY_HEAD='진입점|[Ee]ntry'
# DEC_ID='ADR-[0-9]{3}'
# DEC_HEAD='### '
# 결정 배치 — auto(기본): docs/decisions/ 가 있으면 split. 이전은 bash scripts/split-decisions.sh
# DEC_LAYOUT=split; DEC_DIR=docs/decisions

# ── 브리핑 창 (CLAUDE.md 가 인용하는 숫자와 같게)
# SESS_ENTRIES=3
# DEC_ROWS=25

# ── 캡 (CLAUDE.md 의 HUB_* 는 계약 줄과도 같이 고쳐야 한다)
# BRIEF_SOFT=14000; BRIEF_HARD=20000
# CURTASK_CHARS_SOFT=3200; CURTASK_CHARS_HARD=4200

# ── 게이트 (scripts/check.sh) — 한 줄에 `이름|명령`. 성공은 한 줄, 실패만 전문 (정책 §7)
#    `pnpm -s` 처럼 출력을 지우는 플래그는 쓰지 않는다 — 실패 원인까지 사라진다.
# GATE_STEPS='typecheck|pnpm typecheck
# lint|pnpm lint
# test|pnpm test
# docs|bash scripts/check-docs-budget.sh'
# GATE_SUMMARY_RE='Tests +[0-9]+ passed( \([0-9]+\))?|[0-9]+ passed in [0-9.]+s'
# ── 소스 파일 크기 (줄) — soft 는 경고(손댈 때 나눈다), hard 는 실패. SRC_SOFT=0 이면 끈다
# SRC_SOFT=800; SRC_HARD=1500
# SRC_EXCLUDE='(^|/)(vendor|dist|build|generated)/|\.min\.|\.d\.ts$'

# ── 큰 파일 Read 차단 (훅 scripts/hooks/pre-read-size.sh) — **세션 안** 비용의 1순위다
#    (실측: PNG 5장 = 1,777,896자 = 그 세션 도구 결과의 21%). 금지를 CLAUDE.md 에 적어도
#    지켜지지 않아 기계로 옮긴 것이다. 바이트가 아니라 **디코딩된 문자 수**가 비용이다
#    — PNG 는 base64 로 들어와 대략 파일의 1.37배.
#    ⚠️ 이미지는 막고(hard) 텍스트는 알리기만 한다 — 큰 소스를 한 번 통째로 읽는 것이 정답인
#       경우가 있고, hard 로 막으면 결국 훅을 끄게 된다. ⚠️ 끄려면 0 — 올려서 풀지 말 것.
# READ_IMAGE_HARD=40000
# READ_TEXT_SOFT=60000
# READ_IGNORE=''

# ── 훅이 쓰는 테스트 러너 (scripts/hooks/pre-commit-test.sh)
#    ⚠️ 훅 스크립트는 이 스킬에서 **복사**한 것이라 러너·PATH 를 거기 박으면 다음 갱신에 사라진다.
#    TEST_PATH 는 저장소 기준 상대 경로 — 시스템에 node 가 없는 환경(conda 등)에서만 쓴다.
# TEST_CMD='yarn test'
# TEST_PATH=''
