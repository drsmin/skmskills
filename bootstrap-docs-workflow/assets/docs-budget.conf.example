# scripts/docs-budget.conf — 프로젝트별 값. check-docs-budget.sh 와 session-brief.sh 가 읽는다.
# 스킬의 새 가드로 스크립트를 갈아 끼워도 이 파일은 남는다 — 커스텀은 스크립트가 아니라 여기에 둔다.
# 필요한 줄만 주석을 풀어 쓴다. (bash 로 source 된다)

# ── 도입 모드 — 기존 프로젝트는 warn 으로 시작해 이전을 마치면 block 으로 올린다
# BUDGET_MODE=warn

# ── 문서 형식 — 이 저장소의 형식에 맞춘다. 못 맞추면 가드가 "인식하지 못했다" 로 알린다
# ENTRY_HEAD='진입점|[Ee]ntry'
# DEC_ID='ADR-[0-9]{3}'
# DEC_HEAD='### '
# 결정 배치 — auto(기본): docs/decisions/ 가 있으면 split. 이전은 bash scripts/split-decisions.sh
# DEC_LAYOUT=split; DEC_DIR=docs/decisions

# ── 브리핑 창 (CLAUDE.md 가 인용하는 숫자와 같게)
# SESS_ENTRIES=3
# DEC_ROWS=25

# ── 캡 (CLAUDE.md 의 HUB_* 는 계약 줄과도 같이 고쳐야 한다)
# BRIEF_SOFT=14000; BRIEF_HARD=20000
# CURTASK_CHARS_SOFT=3200; CURTASK_CHARS_HARD=4200

# ── 게이트 (scripts/check.sh) — 한 줄에 `이름|명령`. 성공은 한 줄, 실패만 전문 (정책 §7)
#    `pnpm -s` 처럼 출력을 지우는 플래그는 쓰지 않는다 — 실패 원인까지 사라진다.
# GATE_STEPS='typecheck|pnpm typecheck
# lint|pnpm lint
# test|pnpm test
# docs|bash scripts/check-docs-budget.sh'
# GATE_SUMMARY_RE='Tests +[0-9]+ passed( \([0-9]+\))?|[0-9]+ passed in [0-9.]+s'
# ── 소스 파일 크기 (줄) — soft 는 경고(손댈 때 나눈다), hard 는 실패. SRC_SOFT=0 이면 끈다
# SRC_SOFT=800; SRC_HARD=1500
# SRC_EXCLUDE='(^|/)(vendor|dist|build|generated)/|\.min\.|\.d\.ts$'
